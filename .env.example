# SmartMyOdoo — przykładowa konfiguracja (skopiuj do .env; .env jest gitignored)

# ── Postgres / Odoo (S1.4: nie trzymaj realnych haseł w docker-compose.yml) ──
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=zmien_mnie_na_silne_haslo

# ── Redis (kolejka F7-03) ──
# Domyślnie redis nasłuchuje tylko na 127.0.0.1 (patrz docker-compose.yml).
# Produkcyjnie ustaw hasło i odkomentuj `command: --requirepass` w docker-compose.yml,
# a następnie odzwierciedl je w REDIS_URL: redis://:HASLO@localhost:6379/0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400

# ── LLM / API ──
OPENROUTER_KEY=
MAX_BUDGET_USD=1.0
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── Routing modeli per tier (TRUST-01 T4) — slugi zweryfikowane na OpenRouter ──
# Domyślne (w model_policy.py): CHEAP=sonnet-4.6, STANDARD=sonnet-4.6, PREMIUM=opus-4.8.
# Decyzja 2026-06-25: haiku WYWALONE (gubił rekordy CRM, konfabulował awarie).
# Odkomentuj, by nadpisać (np. przypiąć tańszy model dla CHEAP/dispatchera).
# MODEL_TIER_CHEAP=openrouter/anthropic/claude-sonnet-4.6
# MODEL_TIER_STANDARD=openrouter/anthropic/claude-sonnet-4.6
# MODEL_TIER_PREMIUM=openrouter/anthropic/claude-opus-4.8

# ── Odoo środowisko (dla agenta /odoo) ──
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_main
# ODOO_MASTER_PASSWORD — WYMAGANE do sandboxa (S1.2 fail-closed, brak domyślnego 'admin')
ODOO_MASTER_PASSWORD=
SANDBOX_ENABLED=true

# ══════════════════════════════════════════════════════════════════════════════
# DOCKER (DOCKER-01) — uruchomienie serwisu `app` przez `docker compose up`
# ADR-008 / Sekcja D: ten plik (.env) jest gitignored i NIE trafia do obrazu.
# WYMAGANE w Dockerze: tylko OPENROUTER_KEY (powyżej). Reszta ma domyślne w compose.
# ══════════════════════════════════════════════════════════════════════════════
# UWAGA: w docker-compose.yml serwis `app` używa nazwy serwisu redis (sieć dockera),
# NIE localhost. Jeśli odpalasz przez compose, REDIS_URL ustawiany jest tam na:
#   redis://redis:6379/0
# (linia REDIS_URL powyżej dotyczy uruchomienia poza dockerem.)

# Baza danych w kontenerze — plik na wolumenie /data (4 ukośniki = ścieżka absolutna).
# Poza dockerem zostaw domyślne: sqlite:///smartmyodoo.db
DATABASE_URL=sqlite:////data/smartmyodoo.db

# Katalog stanu vaultu (pin/master salt+key, vault_data.enc). W kontenerze = wolumen /data/vault.
# Poza dockerem (bez ENV) używany jest katalog modułu smartmyodoo/vault/.
VAULT_DIR=/data/vault

# ── Tuning aplikacji (opcjonalne; pomiń, by użyć domyślnych) ──
# LLM_CACHE=false
# CHAT_RATE_MAX=30
# CHAT_RATE_WINDOW_S=60
# PII_ENABLED_DEFAULT=true
